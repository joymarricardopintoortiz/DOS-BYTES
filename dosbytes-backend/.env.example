PORT=3000
NODE_ENV=development

# MongoDB Atlas (reemplaza usuario, contraseña, cluster y nombre de la base)
MONGO_URI=mongodb+srv://<usuario>:<contrasena>@<tu-cluster>.mongodb.net/<nombre_base>?retryWrites=true&w=majority

# Clave larga y aleatoria para firmar los tokens de login
JWT_SECRET=pon_aqui_una_clave_larga_y_dificil
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MINUTES=60
VERIFICATION_TOKEN_EXPIRES_HOURS=24
BCRYPT_ROUNDS=12

# URLs del sitio (el frontend corre con Vite en desarrollo)
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:3000

# Correo transaccional por API: resend | brevo
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=DOS BYTES <no-reply@tudominio.com>
EMAIL_REPLY_TO=
# Copia opcional de avisos internos, separados por coma
EMAIL_ADMIN_COPY=

# Cloudinary (obligatorio en producción: el disco de Render no es permanente)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dosbytes

# Imágenes
UPLOAD_MAX_MB=5
MAX_IMAGES_PER_PRODUCT=8

# Seed de los dos administradores (fundadores). Sin valores reales en el repo.
SEED_ADMIN_1_NAME=Fundador 1
SEED_ADMIN_1_EMAIL=
SEED_ADMIN_1_PASSWORD=
SEED_ADMIN_2_NAME=Fundador 2
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_PASSWORD=

EMAIL_PROVIDER=brevo
EMAIL_API_KEY=xkeysib-tu-clave-aqui
EMAIL_FROM=DOS BYTES <tucorreo@gmail.com>